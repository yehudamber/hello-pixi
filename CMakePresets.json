{
    "version": 10,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_GENERATOR_PLATFORM": null,
                "CMAKE_GENERATOR_TOOLSET": null
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-msvc-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows-clang-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "linux-gcc-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux-clang-libstdcxx-base",
            "hidden": true,
            "inherits": "linux-clang-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-stdlib=libstdc++"
            }
        },
        {
            "name": "linux-clang-libcxx-base",
            "hidden": true,
            "inherits": "linux-clang-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-stdlib=libc++"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug",
            "description": "Debug build using MSVC on Windows",
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "description": "Release build using MSVC on Windows",
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Debug",
            "description": "Debug build using Clang on Windows",
            "inherits": "windows-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release",
            "description": "Release build using Clang on Windows",
            "inherits": "windows-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "description": "Debug build using GCC on Linux",
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux GCC Release",
            "description": "Release build using GCC on Linux",
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-clang-libstdcxx-debug",
            "displayName": "Linux Clang libstdc++ Debug",
            "description": "Debug build using Clang with libstdc++ on Linux",
            "inherits": "linux-clang-libstdcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-clang-libstdcxx-release",
            "displayName": "Linux Clang libstdc++ Release",
            "description": "Release build using Clang with libstdc++ on Linux",
            "inherits": "linux-clang-libstdcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-clang-libcxx-debug",
            "displayName": "Linux Clang libc++ Debug",
            "description": "Debug build using Clang with libc++ on Linux",
            "inherits": "linux-clang-libcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-clang-libcxx-release",
            "displayName": "Linux Clang libc++ Release",
            "description": "Release build using Clang with libc++ on Linux",
            "inherits": "linux-clang-libcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "displayName": "Windows MSVC Release"
        },
        {
            "name": "windows-clang-debug",
            "configurePreset": "windows-clang-debug",
            "displayName": "Windows Clang Debug"
        },
        {
            "name": "windows-clang-release",
            "configurePreset": "windows-clang-release",
            "displayName": "Windows Clang Release"
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "displayName": "Linux GCC Debug"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "displayName": "Linux GCC Release"
        },
        {
            "name": "linux-clang-libstdcxx-debug",
            "configurePreset": "linux-clang-libstdcxx-debug",
            "displayName": "Linux Clang libstdc++ Debug"
        },
        {
            "name": "linux-clang-libstdcxx-release",
            "configurePreset": "linux-clang-libstdcxx-release",
            "displayName": "Linux Clang libstdc++ Release"
        },
        {
            "name": "linux-clang-libcxx-debug",
            "configurePreset": "linux-clang-libcxx-debug",
            "displayName": "Linux Clang libc++ Debug"
        },
        {
            "name": "linux-clang-libcxx-release",
            "configurePreset": "linux-clang-libcxx-release",
            "displayName": "Linux Clang libc++ Release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-clang-debug",
            "configurePreset": "windows-clang-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-clang-release",
            "configurePreset": "windows-clang-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-libstdcxx-debug",
            "configurePreset": "linux-clang-libstdcxx-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-libstdcxx-release",
            "configurePreset": "linux-clang-libstdcxx-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-libcxx-debug",
            "configurePreset": "linux-clang-libcxx-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-libcxx-release",
            "configurePreset": "linux-clang-libcxx-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
